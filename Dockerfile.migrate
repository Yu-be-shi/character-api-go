# atlas バイナリ取り出し用ステージ（再現性のためバージョン固定。更新は dependabot が PR を出す）
FROM arigaio/atlas:1.3.2 AS atlas

# 実行イメージ: psql を持つ postgres-alpine に atlas を載せる。
# atlas でテーブルを適用し、psql でビュー/関数（views/*.sql）を冪等適用するため両方が要る。
FROM postgres:16-alpine
COPY --from=atlas /atlas /usr/local/bin/atlas
COPY migrations /migrations
COPY views /views
COPY seeds /seeds
COPY migrate-entrypoint.sh /usr/local/bin/migrate-entrypoint.sh
RUN chmod +x /usr/local/bin/migrate-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/migrate-entrypoint.sh"]
