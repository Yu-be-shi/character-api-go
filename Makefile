.PHONY: dev test vet build

# ── 開発サーバー（Air ホットリロード） ──────────────────────────────────────────────
dev:
	air -c .air.toml

# ── テスト・静的解析 ─────────────────────────────────────────────────────────────
test:
	go test ./...

vet:
	go vet ./...

# ── ビルド ───────────────────────────────────────────────────────────────────────
build:
	CGO_ENABLED=0 go build -o bin/api ./cmd/api
